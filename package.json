{
  "name": "ai-pr-reviewer",
  "version": "1.0.0",
  "main": "run-review.js",
  "scripts": {
    "review": "node run-review.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix dashboard",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm install --prefix dashboard"
  },
  "dependencies": {
    "@langchain/core": "latest",
    "@langchain/google": "latest",
    "@langchain/groq": "latest",
    "@langchain/langgraph": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "multer": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "concurrently": "latest"
  }
}